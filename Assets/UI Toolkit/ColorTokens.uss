:root {
    --color-overlay-clear: rgba(0, 0, 0, 0);
    --color-overlay-soft: rgba(0, 0, 0, 0.55);
    --color-overlay-modal: rgba(0, 0, 0, 0.7);
    --color-overlay-panel: rgba(4, 6, 10, 0.92);

    --color-surface-base: rgb(12, 16, 24);
    --color-surface-deep: rgb(5, 8, 8);
    --color-surface-panel: rgb(73, 79, 112);
    --color-surface-panel-alt: rgb(43, 50, 77);
    --color-surface-card: rgb(139, 136, 66);
    --color-surface-card-selected: rgb(168, 158, 78);
    --color-surface-frame: rgb(20, 29, 37);
    --color-surface-frame-hover: rgb(35, 45, 56);
    --color-surface-track: rgb(38, 16, 42);
    --color-surface-detail: rgb(150, 150, 150);
    --color-surface-progress-track: rgba(8, 16, 32, 0.9);

    --color-text-primary: rgb(255, 255, 255);
    --color-text-muted: rgb(175, 185, 201);
    --color-text-body: rgb(235, 239, 244);
    --color-text-inverse: rgb(12, 12, 12);
    --color-text-highlight: rgb(255, 244, 201);
    --color-text-subtle: rgb(210, 218, 232);
    --color-text-disabled: rgb(190, 190, 190);

    --color-accent: rgb(239, 191, 99);
    --color-accent-bright: rgb(255, 238, 145);
    --color-accent-divider: rgba(239, 191, 99, 0.35);

    --color-button-base: var(--color-surface-card);
    --color-button-base-hover: var(--color-surface-card-selected);
    --color-button-border: var(--color-accent);
    --color-button-border-hover: var(--color-accent-bright);
    --color-button-danger: rgb(163, 38, 29);
    --color-button-danger-hover: rgb(188, 50, 40);

    --color-action-danger: rgb(163, 38, 29);
    --color-action-success: rgb(49, 166, 76);
    --color-action-success-hover: rgb(62, 187, 92);
    --color-action-primary: rgb(64, 92, 230);
    --color-action-primary-hover: rgb(80, 108, 248);
    --color-action-progress: rgb(45, 131, 255);
    --color-action-disabled: rgb(88, 88, 88);
    --color-action-disabled-border: rgb(180, 154, 90);
    --color-action-strength: rgb(164, 47, 47);
    --color-action-dexterity: rgb(43, 144, 72);
    --color-action-intelligence: rgb(45, 104, 190);
}
