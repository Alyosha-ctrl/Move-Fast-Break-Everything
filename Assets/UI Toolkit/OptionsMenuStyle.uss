@import url("ColorTokens.uss");

.options-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-overlay-panel);
}

.options-menu__panel {
    width: 620px;
    max-width: 100%;
    height: 620px;
    max-height: 90%;
    padding: 18px;
    flex-direction: column;
    background-color: var(--color-surface-panel);
    border-color: var(--color-accent);
    border-width: 2px;
    border-radius: 4px;
}

.options-menu__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.options-menu__title-block {
    flex-grow: 1;
    align-items: flex-start;
}

.options-menu__title {
    color: var(--color-text-primary);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.options-menu__close-button {
    width: 150px;
    height: 58px;
    color: var(--color-text-primary);
    background-color: var(--color-button-danger);
    border-color: var(--color-button-border);
    border-width: 2px;
    border-radius: 4px;
    font-size: 24px;
    -unity-font-style: bold;
}

.options-menu__close-button:hover {
    background-color: var(--color-button-danger-hover);
    border-color: var(--color-button-border-hover);
}

.options-menu__tabs {
    flex-direction: row;
    margin-top: 20px;
    margin-bottom: 4px;
}

.options-menu__tab {
    width: 150px;
    height: 52px;
    margin-right: 12px;
    color: var(--color-text-primary);
    background-color: var(--color-button-base);
    border-color: var(--color-button-border);
    border-width: 2px;
    border-radius: 3px;
    font-size: 18px;
    -unity-font-style: bold;
}

.options-menu__tab:hover {
    background-color: var(--color-button-base-hover);
    border-color: var(--color-button-border-hover);
}

.options-menu__tab--active {
    color: var(--color-text-primary);
    background-color: var(--color-button-base-hover);
    border-color: var(--color-button-border-hover);
}

.options-menu__content {
    flex-grow: 1;
}

.options-menu__scrollview {
    flex-grow: 1;
    margin-top: 12px;
}

.options-menu__scrollview .unity-scroll-view__content-container {
    padding-right: 6px;
}

.options-menu__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 76px;
    margin-top: 10px;
    padding: 12px 14px;
    background-color: var(--color-surface-card);
    border-color: var(--color-accent);
    border-width: 2px;
    border-radius: 3px;
}

.options-menu__row--first {
    margin-top: 0;
}

.options-menu__row-label {
    min-width: 120px;
    color: var(--color-text-primary);
    font-size: 22px;
    -unity-font-style: bold;
}

.options-menu__slider-wrap {
    position: relative;
    top: -2px;
    flex-grow: 1;
    margin-left: 16px;
    justify-content: center;
    align-self: center;
}

.options-menu__slider {
    position: relative;
    flex-grow: 1;
    height: 18px;
}

.options-slider__track {
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: 8px;
    background-color: var(--color-surface-track);
    border-color: var(--color-accent);
    border-width: 1px;
}

.options-slider__fill {
    position: absolute;
    left: 0;
    top: 5px;
    height: 8px;
    background-color: var(--color-accent);
}

.options-slider__knob {
    position: absolute;
    top: 0;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    background-color: var(--color-accent-bright);
    border-color: var(--color-surface-track);
    border-width: 2px;
    border-radius: 2px;
}

.options-menu__binding-button {
    min-width: 120px;
    height: 40px;
    color: var(--color-text-primary);
    background-color: var(--color-surface-frame);
    border-color: var(--color-button-border);
    border-width: 2px;
    border-radius: 3px;
    font-size: 16px;
    -unity-font-style: bold;
}

.options-menu__binding-button:hover {
    background-color: var(--color-surface-frame-hover);
    border-color: var(--color-button-border-hover);
}
