@import url("ColorTokens.uss");

.game-ui-root {
    flex-grow: 1;
    align-items: center;
    padding-top: 16px;
}

.run-coin-root {
    position: absolute;
    top: 16px;
    right: 16px;
    min-width: 90px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--color-overlay-soft);
    border-radius: 6px;
    padding: 6px 12px 6px 10px;
}

.run-coin-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.run-coin-label {
    color: var(--color-text-highlight);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.run-timer-container {
    width: 120px;
}

.run-timer-label {
    width: 100%;
    color: var(--color-text-primary);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: var(--color-overlay-soft);
    border-radius: 6px;
    padding: 6px 12px;
}

.game-over-root {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.game-over-title {
    margin-bottom: 20px;
    color: var(--color-text-primary);
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.game-over-button {
    width: 220px;
    height: 52px;
    margin-top: 10px;
    color: var(--color-text-primary);
    font-size: 20px;
    -unity-font-style: bold;
    background-color: var(--color-button-base);
    border-color: var(--color-button-border);
    border-width: 2px;
    border-radius: 3px;
}

.game-over-button:hover {
    background-color: var(--color-button-base-hover);
    border-color: var(--color-button-border-hover);
}

.game-over-button--primary {
    margin-top: 0;
}

.game-over-button--danger {
    background-color: var(--color-button-danger);
    border-color: var(--color-button-border);
}

.game-over-button--danger:hover {
    background-color: var(--color-button-danger-hover);
    border-color: var(--color-button-border-hover);
}

.level-progress-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 14px;
    justify-content: flex-end;
}

.level-progress-track {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface-progress-track);
}

.level-progress-fill {
    width: 0;
    height: 100%;
    background-color: var(--color-action-progress);
}

.level-up-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-overlay-modal);
}

.pause-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-overlay-panel);
}

.pause-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pause-stats-card {
    width: 300px;
    margin-right: 24px;
    padding: 20px;
    background-color: var(--color-surface-panel-alt);
    border-color: var(--color-accent);
    border-width: 2px;
    border-radius: 4px;
}

.pause-stats-title {
    margin-bottom: 16px;
    color: var(--color-text-primary);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-stats-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding-bottom: 6px;
    border-bottom-color: var(--color-accent-divider);
    border-bottom-width: 1px;
}

.pause-stats-row--last {
    border-bottom-width: 0;
}

.pause-stats-icon-frame {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-frame);
    border-color: var(--color-accent);
    border-width: 1px;
    padding: 3px;
}

.pause-stats-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.pause-stats-name {
    flex-grow: 1;
    color: var(--color-text-subtle);
    font-size: 18px;
    -unity-font-style: bold;
}

.pause-stats-value {
    color: var(--color-text-highlight);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.pause-balance-spacer {
    width: 324px;
}

.pause-panel {
    width: 360px;
    padding: 24px;
    align-items: center;
    background-color: var(--color-surface-panel);
    border-color: var(--color-accent);
    border-width: 2px;
    border-radius: 4px;
}

.pause-title {
    margin-bottom: 24px;
    color: var(--color-text-primary);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-button {
    width: 100%;
    height: 54px;
    margin-top: 12px;
    color: var(--color-text-primary);
    font-size: 22px;
    -unity-font-style: bold;
    background-color: var(--color-button-base);
    border-color: var(--color-button-border);
    border-width: 2px;
    border-radius: 3px;
}

.pause-button:hover {
    background-color: var(--color-button-base-hover);
    border-color: var(--color-button-border-hover);
}

.pause-button--primary {
    margin-top: 0;
}

.pause-button--danger {
    background-color: var(--color-button-danger);
    border-color: var(--color-button-border);
}

.pause-button--danger:hover {
    background-color: var(--color-button-danger-hover);
    border-color: var(--color-button-border-hover);
}

.level-up-title {
    margin-bottom: 24px;
    color: var(--color-text-primary);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-up-card-row {
    flex-direction: row;
}

.level-up-card {
    width: 180px;
    height: 220px;
    margin-left: 10px;
    margin-right: 10px;
    color: var(--color-text-primary);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-up-card--strength {
    background-color: var(--color-action-strength);
}

.level-up-card--dexterity {
    background-color: var(--color-action-dexterity);
}

.level-up-card--intelligence {
    background-color: var(--color-action-intelligence);
}
