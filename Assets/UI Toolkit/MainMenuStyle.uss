@import url("ColorTokens.uss");

:root {
    --menu-background: var(--color-surface-base);
    --menu-copy: var(--color-text-body);
    --menu-copy-muted: var(--color-text-muted);
    --menu-button-hover: var(--color-accent);
    --menu-button-press: var(--color-accent-bright);
    --menu-accent: var(--color-accent);
}

.main-menu {
    flex-grow: 1;
    justify-content: space-between;
    padding: 68px;
    background-color: var(--menu-background);
}

.main-menu__hero {
    max-width: 640px;
}

.main-menu__eyebrow {
    color: var(--menu-accent);
    font-size: 88px;
    -unity-font-style: bold;
}

.main-menu__title {
    margin-top: 10px;
    color: var(--menu-copy);
    font-size: 54px;
    -unity-font-style: bold;
}

.main-menu__actions {
    margin-top: auto;
    align-items: flex-start;
}

.main-menu__button {
    align-self: flex-start;
    margin-top: 12px;
    padding: 2px 4px 2px 0;
    color: var(--menu-copy-muted);
    background-color: var(--color-overlay-clear);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 40px;
}

.main-menu__button:hover {
    background-color: var(--color-overlay-clear);
    color: var(--menu-button-hover);
}

.main-menu__button:active {
    color: var(--menu-button-press);
}

.main-menu__button--primary {
    margin-top: 0;
    color: var(--menu-copy);
    font-size: 68px;
}

.shop-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    background-color: var(--color-overlay-panel);
    padding: 24px 48px 32px;
}

.shop-menu__top-bar {
    width: 760px;
    max-width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.shop-menu__coin-counter {
    width: 150px;
    min-width: 150px;
    max-width: 150px;
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-deep);
    border-color: var(--menu-accent);
    border-width: 2px;
    border-radius: 4px;
    padding-left: 8px;
    padding-right: 10px;
}

.shop-menu__coin-icon {
    width: 28px;
    height: 28px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    align-self: center;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.shop-menu__coin-label {
    color: var(--color-text-primary);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-self: center;
    flex-grow: 1;
    min-width: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.shop-menu__back-button {
    width: 150px;
    height: 58px;
    color: var(--color-text-primary);
    background-color: var(--color-button-danger);
    border-color: var(--color-button-border);
    border-width: 2px;
    border-radius: 4px;
    font-size: 24px;
    -unity-font-style: bold;
}

.shop-menu__back-button:hover {
    background-color: var(--color-button-danger-hover);
    border-color: var(--color-button-border-hover);
}

.shop-menu__panel {
    width: 760px;
    max-width: 100%;
    flex-grow: 1;
    background-color: var(--color-surface-panel);
    border-color: var(--menu-accent);
    border-width: 2px;
    border-radius: 4px;
    padding: 18px;
}

.shop-menu__title {
    color: var(--color-text-primary);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.shop-menu__refund-button {
    align-self: center;
    width: 640px;
    max-width: 100%;
    height: 58px;
    margin-bottom: 16px;
    color: var(--color-text-primary);
    background-color: var(--color-action-primary);
    border-color: var(--color-accent-bright);
    border-width: 2px;
    border-radius: 5px;
    font-size: 28px;
    -unity-font-style: bold;
}

.shop-menu__refund-button:hover {
    background-color: var(--color-action-primary-hover);
    border-color: var(--color-button-border-hover);
}

.shop-menu__refund-button:disabled {
    color: var(--color-text-disabled);
    background-color: var(--color-action-disabled);
    border-color: var(--color-action-disabled-border);
}

.shop-menu__item-scroll {
    flex-grow: 1;
    min-height: 240px;
    margin-bottom: 14px;
}

.shop-menu__item-card {
    min-height: 86px;
    margin-bottom: 8px;
    background-color: var(--color-surface-card);
    border-color: var(--color-accent);
    border-width: 2px;
    border-radius: 3px;
    padding: 10px;
}

.shop-menu__item-row {
    flex-direction: row;
    align-items: center;
}

.shop-menu__item-icon-frame {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-frame);
    border-color: var(--color-accent);
    border-width: 2px;
    margin-right: 12px;
}

.shop-menu__item-icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.shop-menu__item-copy {
    flex-grow: 1;
}

.shop-menu__item-card--selected {
    background-color: var(--color-surface-card-selected);
    border-color: var(--color-accent-bright);
}

.shop-menu__item-title {
    color: var(--color-text-primary);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 8px;
}

.shop-menu__rank-row {
    flex-direction: row;
}

.shop-menu__rank-pip {
    width: 16px;
    height: 16px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: var(--color-surface-track);
    border-color: var(--color-accent);
    border-width: 1px;
}

.shop-menu__rank-pip--filled {
    background-color: var(--color-accent);
}

.shop-menu__details {
    height: 150px;
    min-height: 150px;
    max-height: 150px;
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface-detail);
    border-color: var(--menu-accent);
    border-width: 2px;
    border-radius: 3px;
    padding: 14px;
}

.shop-menu__detail-icon-frame {
    width: 76px;
    height: 76px;
    min-width: 76px;
    max-width: 76px;
    min-height: 76px;
    max-height: 76px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-frame);
    border-color: var(--color-accent);
    border-width: 2px;
    margin-right: 18px;
}

.shop-menu__detail-icon {
    width: 58px;
    height: 58px;
    min-width: 58px;
    max-width: 58px;
    min-height: 58px;
    max-height: 58px;
    -unity-background-scale-mode: scale-to-fit;
}

.shop-menu__detail-copy {
    flex-grow: 1;
    height: 100%;
    min-width: 0;
    margin-right: 16px;
    justify-content: center;
}

.shop-menu__detail-title {
    color: var(--color-text-primary);
    font-size: 22px;
    -unity-font-style: bold;
}

.shop-menu__detail-description {
    color: var(--color-text-primary);
    font-size: 16px;
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    white-space: normal;
    margin-top: 4px;
}

.shop-menu__detail-rank {
    color: var(--color-text-highlight);
    font-size: 16px;
    -unity-font-style: bold;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    margin-top: 2px;
}

.shop-menu__buy-column {
    width: 130px;
    min-width: 130px;
    max-width: 130px;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.shop-menu__detail-cost-row {
    height: 26px;
    min-height: 26px;
    max-height: 26px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
}

.shop-menu__detail-cost-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    align-self: center;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.shop-menu__detail-cost {
    color: var(--color-text-primary);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.shop-menu__buy-button {
    width: 120px;
    height: 52px;
    color: var(--color-text-primary);
    background-color: var(--color-action-success);
    border-color: var(--color-button-border);
    border-width: 2px;
    border-radius: 4px;
    font-size: 22px;
    -unity-font-style: bold;
}

.shop-menu__buy-button:hover {
    background-color: var(--color-action-success-hover);
    border-color: var(--color-button-border-hover);
}
